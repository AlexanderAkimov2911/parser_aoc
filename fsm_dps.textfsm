 ^${time}\s${attacker}(?:'s)?\s${combo}\s${crit}\s${target}\sfor\s${damage}\s${damage_type} -> Record
 ^${time}\s${attacker}(?:'s)?\s${combo}\s${action}\s${target}\sfor\s${damage}\s${damage_type} -> Record
 ^${time}\s${attacker}(?:'s)?\s${combo}\s${crit}\s${action}\s${target}\sfor\s${damage} -> Record
